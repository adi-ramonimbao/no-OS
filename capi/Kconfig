menuconfig CAPI
	bool "CAPI (Common API) abstraction layer"
	default n
	help
	  Enable the CAPI common-API abstraction layer. CAPI provides a
	  platform-neutral dispatcher layer (capi/src) with platform-specific
	  backends (capi/platform/<platform>). Each peripheral module below
	  enables its dispatcher; the matching backend is compiled from the
	  active platform's directory and selects PS vs PL hardware internally
	  via #ifdef on the BSP-provided XPAR_* macros.

if CAPI

config CAPI_UART
	bool "CAPI UART"
	default n

config CAPI_UART_DIRECT_API
	bool "CAPI UART direct API (link-time binding)"
	depends on CAPI_UART
	default n
	help
	  Bind capi_uart_* directly to the active platform driver via symbol
	  aliases instead of the ops-pointer dispatcher, and drop
	  capi/src/capi_uart.c. Safe because no-OS builds one platform per image.

config CAPI_ALLOC
	bool "CAPI alloc"
	default n

config CAPI_TIME
	bool "CAPI time"
	default n

config CAPI_GPIO
	bool "CAPI GPIO"
	default n

config CAPI_GPIO_DIRECT_API
	bool "CAPI GPIO direct API (link-time binding)"
	depends on CAPI_GPIO
	default n
	help
	  Bind capi_gpio_* directly to the active platform driver via symbol
	  aliases instead of the ops-pointer dispatcher, and drop
	  capi/src/capi_gpio.c. Safe because no-OS builds one platform per image.

config CAPI_IRQ
	bool "CAPI IRQ"
	default n

