menuconfig CAPI
	bool "CAPI (Common API) abstraction layer"
	default n
	help
	  Enable the CAPI common-API abstraction layer. CAPI provides a
	  platform-neutral dispatcher layer (capi/src) with platform-specific
	  backends (capi/platform/<platform>). Each peripheral module below
	  enables its dispatcher; the matching backend is compiled from the
	  active platform's directory and selects PS vs PL hardware internally
	  via #ifdef on the BSP-provided XPAR_* macros.

if CAPI

config CAPI_UART
	bool "CAPI UART"
	default n

config CAPI_USB_UART
	bool "CAPI USB UART (CDC-ACM)"
	depends on CAPI_UART && CAPI_IRQ
	default n
	help
	  Enable the USB CDC-ACM backend of CAPI UART on platforms that
	  provide one (currently Maxim MAX32690). The device enumerates as a
	  virtual serial port and is driven through the regular capi_uart_*
	  API by selecting the platform's USB UART ops at init.

config CAPI_ALLOC
	bool "CAPI alloc"
	default n

config CAPI_TIME
	bool "CAPI time"
	default n

config CAPI_GPIO
	bool "CAPI GPIO"
	default n

config CAPI_IRQ
	bool "CAPI IRQ"
	default n

config CAPI_SPI
	bool "CAPI SPI"
	default n

config CAPI_TIMER
	bool "CAPI timer"
	default n

config CAPI_I2C
	bool "CAPI I2C"
	default n

config CAPI_DMA
	bool "CAPI DMA"
	default n

config CAPI_WDT
	bool "CAPI WDT"
	default n

config CAPI_PINT
	bool "CAPI PINT"
	default n

endif # CAPI
