# Platform-specific direct-API selectors (e.g. Xilinx PS/PL variant choice).
# Sourced unconditionally: the symbols only gate the matching platform's driver
# sources, which are compiled solely when that PLATFORM is active.
source "capi/platform/xilinx/Kconfig"

